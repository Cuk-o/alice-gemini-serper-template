# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: any OpenAI-compatible API instead of Gemini (Groq by default, free tier)
LLM_API_KEY=
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=llama-3.3-70b-versatile
